# Copy to .env.local; never commit the populated file.
PUBLIC_URL=http://localhost:3000
DEPLOYMENT_ENV=development
DATABASE_URL=postgresql://lottus:change-me@localhost:5432/lottus
# Generate each independently: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
LICENSE_ENCRYPTION_KEY=
LICENSE_LOOKUP_KEY=
OIDC_ISSUER=https://auth.najacorp.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ALLOW_LOCAL_OIDC=false
PAYMENT_ENV=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local emulator only; forbidden in production
STRIPE_API_BASE=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Device limit requires an approved commercial decision. No default.
DEVICE_LIMIT=
LICENSE_SIGNING_KID=
# PKCS8 Ed25519 private PEM and SPKI public PEM; escape line breaks with \n
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=
# Reserved integration configuration; adapters not yet implemented.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
